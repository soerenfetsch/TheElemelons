  m_Name: IntroCutscene
  m_EditorClassIdentifier: 
  isSlideShow: 1
  dialogueBoxImage: {fileID: -253876386, guid: dfc348bf49832804086a1e00827d2ec2, type: 3}
  speakerName: 
  portraitImage: {fileID: 0}
  sceneImage: {fileID: 0}
  dialogueLines:
  - linePortrait: {fileID: 0}
    lineSentenceText: 'In an age not far forgotten, there stood a kingdom crowned
      with peace. '
    lineSceneImage: {fileID: 21300000, guid: bfb140e00e651fc40bb848b0cdfb6341, type: 3}
    overrideDialogueBoxImage: {fileID: 0}
  - linePortrait: {fileID: 0}
    lineSentenceText: '

'
    lineSceneImage: {fileID: 21300000, guid: bfb140e00e651fc40bb848b0cdfb6341, type: 3}
    overrideDialogueBoxImage: {fileID: 0}
  - linePortrait: {fileID: 0}
    lineSentenceText: "In this realm, four ancient forces\u2014earth, air, fire,
      and water\u2014"
    lineSceneImage: {fileID: -885508010, guid: 3f6cac7538a548947a75c11c6024c787, type: 3}
    overrideDialogueBoxImage: {fileID: 0}
  - linePortrait: {fileID: 0}
    lineSentenceText: 
    lineSceneImage: {fileID: 21300000, guid: 9646b5ed50834c347918f37d9484558a, type: 3}
    overrideDialogueBoxImage: {fileID: 0}
  - linePortrait: {fileID: 0}
    lineSentenceText: 'took form as the Elemelons. '
    lineSceneImage: {fileID: 21300000, guid: 3de239d5db1d1264cad1bbddd8cbe3fe, type: 3}
    overrideDialogueBoxImage: {fileID: 0}
  - linePortrait: {fileID: 0}
    lineSentenceText: 'took form as the Elemelons. '
    lineSceneImage: {fileID: 21300000, guid: 3de239d5db1d1264cad1bbddd8cbe3fe, type: 3}
    overrideDialogueBoxImage: {fileID: 0}
  - linePortrait: {fileID: 0}
    lineSentenceText: 
    lineSceneImage: {fileID: 21300000, guid: 3de239d5db1d1264cad1bbddd8cbe3fe, type: 3}
    overrideDialogueBoxImage: {fileID: 0}
  - linePortrait: {fileID: 0}
    lineSentenceText: To subdue them, it needed
    lineSceneImage: {fileID: 21300000, guid: 66bee685636773649962dcc52e68900f, type: 3}
    overrideDialogueBoxImage: {fileID: 0}
  - linePortrait: {fileID: 0}
    lineSentenceText: One crown to rule them all.
    lineSceneImage: {fileID: 21300000, guid: 66bee685636773649962dcc52e68900f, type: 3}
    overrideDialogueBoxImage: {fileID: 0}
  - linePortrait: {fileID: 0}
    lineSentenceText: 
    lineSceneImage: {fileID: 21300000, guid: ed8b84f5f6a0c9a448d32446ac94dea6, type: 3}
    overrideDialogueBoxImage: {fileID: 0}
  - linePortrait: {fileID: 0}
    lineSentenceText: But one day, an unsavoury character appeared
    lineSceneImage: {fileID: 21300000, guid: c40fdf84c77b9fa4e841f4fb17c51515, type: 3}
    overrideDialogueBoxImage: {fileID: 0}
  - linePortrait: {fileID: 0}
    lineSentenceText: 
    lineSceneImage: {fileID: 21300000, guid: 6a69073e5dc5b0540a01f4035bed9133, type: 3}
    overrideDialogueBoxImage: {fileID: 0}
  - linePortrait: {fileID: 0}
    lineSentenceText: The void witch
    lineSceneImage: {fileID: 21300000, guid: 6a69073e5dc5b0540a01f4035bed9133, type: 3}
    overrideDialogueBoxImage: {fileID: 0}
  - linePortrait: {fileID: 0}
    lineSentenceText: 'She entered the castle under false pretenses '
    lineSceneImage: {fileID: 21300000, guid: 47113cb0bf2da2a4b80a84b1f5b5b165, type: 3}
    overrideDialogueBoxImage: {fileID: 0}
  - linePortrait: {fileID: 0}
    lineSentenceText: 
    lineSceneImage: {fileID: 21300000, guid: 47113cb0bf2da2a4b80a84b1f5b5b165, type: 3}
    overrideDialogueBoxImage: {fileID: 0}
  - linePortrait: {fileID: 0}
    lineSentenceText: 
    lineSceneImage: {fileID: 21300000, guid: 62e42ec71659d19429e9737cbbe14fa1, type: 3}
    overrideDialogueBoxImage: {fileID: 0}
  - linePortrait: {fileID: 0}
    lineSentenceText: And took the Elemelons, throwing the kingdom out of balance.
    lineSceneImage: {fileID: 21300000, guid: 62e42ec71659d19429e9737cbbe14fa1, type: 3}
    overrideDialogueBoxImage: {fileID: 0}
  - linePortrait: {fileID: 0}
    lineSentenceText: 
    lineSceneImage: {fileID: 21300000, guid: 6075db031f84bb445b0250843d1d5cde, type: 3}
    overrideDialogueBoxImage: {fileID: 0}
