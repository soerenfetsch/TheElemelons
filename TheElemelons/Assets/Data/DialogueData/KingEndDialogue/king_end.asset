%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cb405cef0dba10f498390b365ac5b3f4, type: 3}
  m_Name: king_end
  m_EditorClassIdentifier: 
  dialogueBoxImage: {fileID: 1301518215, guid: dfc348bf49832804086a1e00827d2ec2, type: 3}
  speakerName: King
  portraitImage: {fileID: 21300000, guid: cd2252702510e1b4283947f32e751599, type: 3}
  dialogueLines:
  - lineType: 0
    linePortrait: {fileID: 21300000, guid: cb0c139a2486cf641af0c4c170cff6e7, type: 3}
    lineSentenceText: Ah, brave champion! You have returned...
    lineSceneImage: {fileID: 0}
    overrideDialogueBoxImage: {fileID: 0}
  - lineType: 0
    linePortrait: {fileID: 21300000, guid: cb0c139a2486cf641af0c4c170cff6e7, type: 3}
    lineSentenceText: and your hands, the Earth Elemelon!
    lineSceneImage: {fileID: 0}
    overrideDialogueBoxImage: {fileID: 0}
  - lineType: 0
    linePortrait: {fileID: 21300000, guid: cb0c139a2486cf641af0c4c170cff6e7, type: 3}
    lineSentenceText: Never did i think I would lay eyes on its verdant glow again...
    lineSceneImage: {fileID: 0}
    overrideDialogueBoxImage: {fileID: 0}
  - lineType: 0
    linePortrait: {fileID: 21300000, guid: cb0c139a2486cf641af0c4c170cff6e7, type: 3}
    lineSentenceText: Come! Let me place it back where it belongs-in the throne room.
    lineSceneImage: {fileID: 0}
    overrideDialogueBoxImage: {fileID: 0}
  - lineType: 0
    linePortrait: {fileID: 21300000, guid: cb0c139a2486cf641af0c4c170cff6e7, type: 3}
    lineSentenceText: The soil shall once again breathe life into our lands.
    lineSceneImage: {fileID: 0}
    overrideDialogueBoxImage: {fileID: 0}
  - lineType: 0
    linePortrait: {fileID: 21300000, guid: cb0c139a2486cf641af0c4c170cff6e7, type: 3}
    lineSentenceText: The balance is one step closer to being restored.
    lineSceneImage: {fileID: 0}
    overrideDialogueBoxImage: {fileID: 0}
  - lineType: 0
    linePortrait: {fileID: 21300000, guid: cb0c139a2486cf641af0c4c170cff6e7, type: 3}
    lineSentenceText: You, my valiant friend, are the bearer of light.
    lineSceneImage: {fileID: 0}
    overrideDialogueBoxImage: {fileID: 0}
  - lineType: 0
    linePortrait: {fileID: 21300000, guid: cb0c139a2486cf641af0c4c170cff6e7, type: 3}
    lineSentenceText: in our kingdom's darkest hours.
    lineSceneImage: {fileID: 0}
    overrideDialogueBoxImage: {fileID: 0}
  - lineType: 0
    linePortrait: {fileID: 21300000, guid: cb0c139a2486cf641af0c4c170cff6e7, type: 3}
    lineSentenceText: Now go, hero. The journey is not yet over-
    lineSceneImage: {fileID: 0}
    overrideDialogueBoxImage: {fileID: 0}
  - lineType: 0
    linePortrait: {fileID: 21300000, guid: cb0c139a2486cf641af0c4c170cff6e7, type: 3}
    lineSentenceText: but for this moment, let us bask in victory.
    lineSceneImage: {fileID: 0}
    overrideDialogueBoxImage: {fileID: 0}
