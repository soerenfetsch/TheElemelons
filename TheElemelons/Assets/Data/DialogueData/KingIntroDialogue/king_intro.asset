%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cb405cef0dba10f498390b365ac5b3f4, type: 3}
  m_Name: king_intro
  m_EditorClassIdentifier: 
  dialogueBoxImage: {fileID: 1301518215, guid: dfc348bf49832804086a1e00827d2ec2, type: 3}
  speakerName: King
  portraitImage: {fileID: 21300000, guid: cd2252702510e1b4283947f32e751599, type: 3}
  sceneImage: {fileID: 0}
  dialogueLines:
  - lineType: 0
    linePortrait: {fileID: 21300000, guid: cd2252702510e1b4283947f32e751599, type: 3}
    lineSentenceText: "Ah... you\u2019ve come at last.\r\n"
    lineSceneImage: {fileID: 0}
    overrideDialogueBoxImage: {fileID: 0}
  - lineType: 0
    linePortrait: {fileID: 21300000, guid: cb0c139a2486cf641af0c4c170cff6e7, type: 3}
    lineSentenceText: "\rDark times have fallen upon the realm, my child.\r\n"
    lineSceneImage: {fileID: 0}
    overrideDialogueBoxImage: {fileID: 0}
  - lineType: 0
    linePortrait: {fileID: 21300000, guid: d320fdd41be1b5f43bf717b53e913aa4, type: 3}
    lineSentenceText: "The Elemelons\u2014the sacred fruits of balance...\r\n"
    lineSceneImage: {fileID: 0}
    overrideDialogueBoxImage: {fileID: 0}
  - lineType: 0
    linePortrait: {fileID: 21300000, guid: cb0c139a2486cf641af0c4c170cff6e7, type: 3}
    lineSentenceText: 'have been stolen from my castle.

'
    lineSceneImage: {fileID: 0}
    overrideDialogueBoxImage: {fileID: 0}
  - lineType: 0
    linePortrait: {fileID: 21300000, guid: cd2252702510e1b4283947f32e751599, type: 3}
    lineSentenceText: "It was her\u2026 The Void Witch.\r\n"
    lineSceneImage: {fileID: 0}
    overrideDialogueBoxImage: {fileID: 0}
  - lineType: 0
    linePortrait: {fileID: 21300000, guid: cb0c139a2486cf641af0c4c170cff6e7, type: 3}
    lineSentenceText: 'Once a guardian of the arcane, now twisted by greed.

'
    lineSceneImage: {fileID: 0}
    overrideDialogueBoxImage: {fileID: 0}
  - lineType: 0
    linePortrait: {fileID: 21300000, guid: cd2252702510e1b4283947f32e751599, type: 3}
    lineSentenceText: "She\u2019s turned against us\u2026 and cloaked herself in
      darkness.\r\n"
    lineSceneImage: {fileID: 0}
    overrideDialogueBoxImage: {fileID: 0}
  - lineType: 0
    linePortrait: {fileID: 21300000, guid: cb0c139a2486cf641af0c4c170cff6e7, type: 3}
    lineSentenceText: 'You, alone, may stand against her.

'
    lineSceneImage: {fileID: 0}
    overrideDialogueBoxImage: {fileID: 0}
  - lineType: 0
    linePortrait: {fileID: 21300000, guid: d320fdd41be1b5f43bf717b53e913aa4, type: 3}
    lineSentenceText: "To restore balance, you must retrieve the Earth Elemelon.\r\n
      \r\n"
    lineSceneImage: {fileID: 0}
    overrideDialogueBoxImage: {fileID: 0}
  - lineType: 0
    linePortrait: {fileID: 21300000, guid: cd2252702510e1b4283947f32e751599, type: 3}
    lineSentenceText: "The Elemelon of endurance and stability.\r\r"
    lineSceneImage: {fileID: 0}
    overrideDialogueBoxImage: {fileID: 0}
  - lineType: 0
    linePortrait: {fileID: 21300000, guid: cb0c139a2486cf641af0c4c170cff6e7, type: 3}
    lineSentenceText: It was the first she took.
    lineSceneImage: {fileID: 0}
    overrideDialogueBoxImage: {fileID: 0}
  - lineType: 0
    linePortrait: {fileID: 21300000, guid: cd2252702510e1b4283947f32e751599, type: 3}
    lineSentenceText: 'Hidden away beyond the South Room of this castle,

'
    lineSceneImage: {fileID: 0}
    overrideDialogueBoxImage: {fileID: 0}
  - lineType: 0
    linePortrait: {fileID: 21300000, guid: cb0c139a2486cf641af0c4c170cff6e7, type: 3}
    lineSentenceText: ' a portal is hidden.

'
    lineSceneImage: {fileID: 0}
    overrideDialogueBoxImage: {fileID: 0}
  - lineType: 0
    linePortrait: {fileID: 21300000, guid: 3ef0004880c3ef246ad561f6f2780fa0, type: 3}
    lineSentenceText: 'It will bring you to her hideout.

'
    lineSceneImage: {fileID: 0}
    overrideDialogueBoxImage: {fileID: 0}
  - lineType: 0
    linePortrait: {fileID: 21300000, guid: cd2252702510e1b4283947f32e751599, type: 3}
    lineSentenceText: "But beware\u2014she has summoned monsters to guard her lair.\r\n"
    lineSceneImage: {fileID: 0}
    overrideDialogueBoxImage: {fileID: 0}
  - lineType: 0
    linePortrait: {fileID: 21300000, guid: cb0c139a2486cf641af0c4c170cff6e7, type: 3}
    lineSentenceText: 'Beasts of soil and stone, fueled by her vile will.

'
    lineSceneImage: {fileID: 0}
    overrideDialogueBoxImage: {fileID: 0}
  - lineType: 0
    linePortrait: {fileID: 21300000, guid: 3ef0004880c3ef246ad561f6f2780fa0, type: 3}
    lineSentenceText: "Venture forth. Enter the Earth Portal. \r\n"
    lineSceneImage: {fileID: 0}
    overrideDialogueBoxImage: {fileID: 0}
  - lineType: 0
    linePortrait: {fileID: 21300000, guid: d320fdd41be1b5f43bf717b53e913aa4, type: 3}
    lineSentenceText: "Face what lies beyond\u2014and return to us with the Elemelon.\r\n"
    lineSceneImage: {fileID: 0}
    overrideDialogueBoxImage: {fileID: 0}
  - lineType: 0
    linePortrait: {fileID: 21300000, guid: cb0c139a2486cf641af0c4c170cff6e7, type: 3}
    lineSentenceText: The fate of the realm rests in your hands
    lineSceneImage: {fileID: 0}
    overrideDialogueBoxImage: {fileID: 0}
